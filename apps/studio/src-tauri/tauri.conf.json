{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feather Studio",
  "version": "0.1.0-rc.1",
  "identifier": "com.kyonru.love.feather.studio",
  "build": {
    "beforeDevCommand": "pnpm --filter @feather/studio run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm --filter @feather/studio run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Feather Studio",
        "minWidth": 900,
        "minHeight": 640,
        "width": 1280,
        "height": 820,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {}
  }
}
