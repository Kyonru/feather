#!/usr/bin/env sh
set -eu

if [ "${SKIP_PRE_PUSH_TESTS:-}" = "1" ]; then
  echo "[feather] SKIP_PRE_PUSH_TESTS=1 set; skipping pre-push tests."
  exit 0
fi

# One definition of "the test suite", shared with `pnpm run test`, so what you run
# locally is exactly what gates the push. It goes through turbo, so an unchanged
# suite is a cache hit rather than a rerun, and runs the lanes serially because
# the browser and CLI suites time each other out when run at once.
pnpm run test
