{
  "name": "feather",
  "description": "Feather is a LÖVE game development toolkit with a desktop inspector, zero-config CLI, plugin system, build/upload helpers, and package management.",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "workspaces": [
    "cli",
    "packages/protocol",
    "vscode-extension"
  ],
  "scripts": {
    "cli:build": "pnpm --filter @kyonru/feather run build",
    "cli:dev": "pnpm --filter @kyonru/feather run dev",
    "test:cli:e2e": "pnpm run cli:build && node --test cli/test/commands/*.test.mjs",
    "test:lua:e2e": "node scripts/lua-e2e.mjs",
    "test:packages:e2e": "node scripts/package-e2e.mjs",
    "test:app:e2e": "playwright test",
    "test:showcase:e2e": "playwright test -c playwright.showcase.config.ts",
    "test:tauri:e2e": "cargo test --manifest-path src-tauri/Cargo.toml ws_server",
    "extension:prepare": "pnpm run cli:build && pnpm --filter @kyonru/feather run bundle:lua && node vscode-extension/scripts/prepare.mjs",
    "extension:build": "pnpm run extension:prepare && tsc -p vscode-extension/tsconfig.json",
    "extension:binary": "pnpm run cli:build && pnpm --filter @kyonru/feather run bundle:lua && pnpm --filter @kyonru/feather run build:binary",
    "extension:test": "pnpm run extension:build && pnpm --filter feather-cli-vscode run test",
    "extension:test:integration": "pnpm run extension:build && pnpm --filter feather-cli-vscode run test:integration",
    "extension:package": "pnpm run extension:binary && pnpm run extension:build && pnpm --filter feather-cli-vscode run generate:icon && cd vscode-extension && npx @vscode/vsce package",
    "feather": "pnpm --filter @kyonru/feather run bundle:lua && pnpm run cli:build && node cli/dist/index.js",
    "dev": "vite",
    "dev:tauri": "vite --force",
    "dev:lua": "concurrently \"vite\" \"sh ./scripts/watch-lua.sh\"",
    "docs": "bash scripts/docs.sh",
    "native": "pnpm run tauri build -- --debug",
    "prepare:tauri-cli-sidecar": "pnpm --filter @kyonru/feather run build:binary && node scripts/prepare-tauri-cli-sidecar.mjs",
    "lua": "sh ./scripts/watch-lua.sh",
    "web": "vite",
    "build": "tsc && vite build",
    "showcase:dev": "vite --config vite.showcase.config.ts",
    "showcase:build": "tsc --noEmit -p tsconfig.json --composite false && vite build --config vite.showcase.config.ts && node scripts/prepare-showcase-lovejs.mjs && node scripts/build-showcase-love.mjs",
    "showcase:prepare-lovejs": "node scripts/prepare-showcase-lovejs.mjs",
    "showcase:preview": "vite preview --config vite.showcase.config.ts",
    "showcase:start": "node scripts/serve-showcase.mjs",
    "preview": "vite preview",
    "typecheck:web": "tsc --noEmit -p tsconfig.json --composite false",
    "typecheck:lua": "luacheck src-lua",
    "typecheck:protocol": "tsc --noEmit -p packages/protocol/tsconfig.json",
    "typecheck": "pnpm run typecheck:web && pnpm run typecheck:protocol && pnpm run typecheck:lua",
    "generate:plugin-catalog": "node scripts/generate-plugin-catalog.mjs",
    "check:plugin-catalog": "pnpm run generate:plugin-catalog && git diff --exit-code cli/src/generated/plugin-catalog.ts",
    "generate:protocol-lua": "node packages/protocol/scripts/generate-lua.mjs",
    "check:protocol": "node scripts/check-protocol.mjs",
    "package:add": "pnpm --filter @kyonru/feather run package:add",
    "package:add-url": "pnpm --filter @kyonru/feather run package:add-url",
    "package:update": "pnpm --filter @kyonru/feather run package:update",
    "package:remove": "pnpm --filter @kyonru/feather run package:remove",
    "package:licenses": "node scripts/backfill-license-files.mjs",
    "generate:registry": "node scripts/generate-registry.mjs",
    "check:registry": "pnpm run generate:registry && git diff --exit-code cli/src/generated/registry.json",
    "verify:packages": "node scripts/compute-checksums.mjs --all",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@codemirror/commands": "6.10.3",
    "@codemirror/language": "6.12.3",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.43.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@lezer/highlight": "1.2.3",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/query-async-storage-persister": "5.100.10",
    "@tanstack/react-query": "5.100.10",
    "@tanstack/react-query-persist-client": "5.100.10",
    "@tanstack/react-table": "8.21.3",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@xyflow/react": "12.10.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "gif.js": "0.2.0",
    "gif.js.optimized": "1.0.1",
    "lucide-react": "1.16.0",
    "next-themes": "0.4.6",
    "prism-react-renderer": "2.4.1",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.11.1",
    "react-router": "7.15.1",
    "react-syntax-highlighter": "16.1.1",
    "react-virtuoso": "4.18.7",
    "recharts": "3.8.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "vaul": "1.1.2",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@tanstack/eslint-plugin-query": "5.100.10",
    "@tauri-apps/cli": "2.11.2",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "10.0.3",
    "eslint": "10.3.0",
    "husky": "9.1.7",
    "turbo": "2.10.12",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  }
}
