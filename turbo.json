{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.json", "pnpm-lock.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", "lua/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["apps/inspector/src/**", "tsconfig.json"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["apps/inspector/src/**", "test/**"]
    },

    "//#typecheck:web": {
      "inputs": ["apps/inspector/src/**", "tsconfig.json", "packages/protocol/src/**"]
    },
    "//#typecheck:protocol": {
      "inputs": ["packages/protocol/**"]
    },
    "//#typecheck:lua": {
      "inputs": ["packages/runtime-lua/**", ".luacheckrc"]
    },
    "//#lint": {
      "inputs": ["apps/inspector/src/**", "eslint.config.js", ".eslintrc"]
    },
    "//#check:protocol": {
      "inputs": [
        "packages/protocol/src/messages.ts",
        "apps/inspector/src/constants/feather-protocol.ts",
        "apps/inspector/src/hooks/use-ws-connection.ts",
        "packages/runtime-lua/feather/init.lua",
        "packages/runtime-lua/feather/protocol_messages.lua"
      ]
    },
    "//#test:unit": {
      "inputs": ["scripts/tests/**", "apps/studio/src/**", "apps/inspector/src/**"]
    },
    "//#test:bridge": {
      "inputs": ["packages/session-bridge/**"]
    },
    "//#test:lua:e2e": {
      "inputs": ["packages/runtime-lua/**", "scripts/lua-e2e.mjs"]
    },
    "//#test:cli:e2e": {
      "inputs": ["cli/**", "packages/runtime-lua/**"]
    },
    "//#test:inspector:e2e": {
      "inputs": ["apps/inspector/src/**", "apps/inspector/e2e/**", "packages/*/src/**", "apps/inspector/playwright.config.ts", "vite.config.ts"]
    },
    "//#test:studio:e2e": {
      "inputs": ["apps/studio/**", "packages/*/src/**"]
    },
    "//#test:showcase:e2e": {
      "inputs": ["apps/studio/src/**", "apps/showcase/**", "packages/*/src/**"]
    },
    "//#check:registry": {
      "inputs": ["catalog/packages/*.json", "scripts/generate-registry.mjs"]
    },
    "//#check:plugin-catalog": {
      "inputs": ["packages/runtime-lua/plugins/**", "scripts/generate-plugin-catalog.mjs"]
    }
  }
}
